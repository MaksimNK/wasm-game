{
  "packages": [
    "emscripten@5.0.6",
    "curl@8.17.0",
    "yt-dlp@latest"
  ],
  "shell": {
    "scripts": {
      "fetch-deps": [
        "set -e",
        "mkdir -p deps",
        "echo 'Fetching dependencies...'",
        "if [ ! -f deps/minimp3.h ]; then",
        "  curl -sL -o deps/minimp3.h https://raw.githubusercontent.com/lieff/minimp3/master/minimp3.h",
        "  curl -sL -o deps/minimp3_ex.h https://raw.githubusercontent.com/lieff/minimp3/master/minimp3_ex.h",
        "fi",
        "if [ ! -f deps/kiss_fft.h ]; then",
        "  curl -sL -o deps/kiss_fft.h https://raw.githubusercontent.com/mborgerding/kissfft/master/kiss_fft.h",
        "  curl -sL -o deps/kiss_fft.c https://raw.githubusercontent.com/mborgerding/kissfft/master/kiss_fft.c",
        "  curl -sL -o deps/_kiss_fft_guts.h https://raw.githubusercontent.com/mborgerding/kissfft/master/_kiss_fft_guts.h",
        "  curl -sL -o deps/kiss_fft_log.h https://raw.githubusercontent.com/mborgerding/kissfft/master/kiss_fft_log.h",
        "fi",
        "echo 'Dependencies ready.'"
      ],
      "build": [
        "set -e",
        "export EM_CACHE=\"$PWD/.emscripten_cache\"",
        "mkdir -p \"$EM_CACHE\"",
        "[ -f deps/kiss_fft.h ] || devbox run fetch-deps",
        "mkdir -p audio out",
        "cp static/index.html out/index.html",
        "emcc src/main.cpp src/audio.cpp src/components.cpp src/events.cpp src/systems.cpp src/render.cpp deps/kiss_fft.c -o out/game.js -I include -I deps -s USE_SDL=2 -s FULL_ES2=1 -s WASM=1 -s ALLOW_MEMORY_GROWTH=1 --preload-file audio -lm -O2",
        "echo 'Build complete: out/'"
      ],
      "run": [
        "set -e",
        "[ -f out/game.js ] || devbox run build",
        "OLD_PID=$(fuser 6931/tcp 2>/dev/null | tr -d ' ')",
        "[ -n \"$OLD_PID\" ] && kill $OLD_PID 2>/dev/null || true",
        "xdg-open http://localhost:6931/index.html 2>/dev/null || open http://localhost:6931/index.html 2>/dev/null || true",
        "busybox httpd -f -p 6931 -h out/"
      ],
      "clean": [
        "rm -rf out/game.js out/game.wasm out/index.html out/game.data",
        "echo 'Cleaned.'"
      ]
    }
  }
}
